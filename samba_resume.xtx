    %==================== Profile ====================

    \section{Profile}
    \begin{onecolentry}
    Senior Software Engineer with 5+ years of experience architecting and delivering scalable backend systems, distributed data pipelines, and production-grade AI applications. Strong track record building microservices (Java Spring Boot, Python FastAPI, Node.js), ETL/training pipelines (Apache Spark/Scala), and AI-powered customer experiences including LLM chatbots and recommendation platforms with observability, reliability, and cost controls across cloud environments (AWS, GCP).
    \end{onecolentry}

    %==================== Skills ====================

    \section{Skills}
    \begin{onecolentry}
        \begin{highlights}
            \item \textbf{Programming:} Java, Kotlin, Python (FastAPI, Flask), JavaScript/Node.js, Go, SQL, Bash, HTML, CSS, HCL
            \item \textbf{Cloud \& DevOps:} AWS, GCP, Docker, Kubernetes, Helm, Terraform, Pulumi, Git, Jenkins, CI/CD, Redis
            \item \textbf{Data \& AI Systems:} Apache Spark, Scala, Temporal, RabbitMQ, Elasticsearch, Vector Search (e.g., FAISS/Weaviate), LangChain, LangGraph, Google ADK, LangSmith (observability), TensorFlow
            \item \textbf{Databases:} MongoDB, MSSQL Server
        \end{highlights}
    \end{onecolentry}   

    %==================== Experience ====================

    \section{Experience}
    \begin{onecolentry}

        \textbf{The Home Depot} \hfill \textit{Jun 2025 – Present | Atlanta, GA} \\
        Senior Software Engineer
        \begin{highlights}
            \item Built and enhanced the \textbf{Magic Apron Assistant} (LLM chatbot) using agentic orchestration frameworks (e.g., Google ADK, LangChain/LangGraph), improving response quality and reliability through structured tool calling and workflow routing.
            \item Implemented efficient \textbf{conversation memory} and context management patterns for multi-turn interactions, enabling scalable session handling and improved user experience.
            \item Added end-to-end \textbf{observability} for AI workflows (e.g., tracing/metrics/logging with LangSmith-style telemetry patterns) to monitor latency, errors, and LLM usage and improve production troubleshooting.
            \item Implemented \textbf{rate limiting and backpressure} controls to protect downstream model/tool dependencies and improve system stability under load.
            \item Collaborated with Google on a specialized \textbf{Garden Agent} solution for garden-related customer experiences, leveraging Magic Apron capabilities and integrating domain-specific tools and flows.
            \item Led the design and prototype development for \textbf{unifying Live Chat and Magic Apron}, enabling routing across multiple AI agents and laying the foundation to scale additional agent connections in the future.
            \item Designed and developed an internal engineering tool with both \textbf{TUI and Web UI} interfaces to help engineers harness AI for faster design and implementation workflows.
            \item Contributed to \textbf{model deployment}, \textbf{ETL/data pipelines}, and \textbf{recommendations serving} capabilities, supporting batch/online workflows and operational metrics.
        \end{highlights}

        \vspace{0.25 cm}

        \textbf{Availity} \hfill \textit{Feb 2020 – Jun 2025 | Atlanta, GA} \\
        Software Engineer IV
        \begin{highlights}
            \item Led a redesign of a legacy application by integrating Apache Spark pipelines and Scala, enhancing performance \& scalability and reducing cost by 90\% to support multi-tenant workloads.
            \item Developed an internal Confluence chatbot for knowledge management—implemented REST endpoints using Python FastAPI, integrated LLMs with Retrieval-Augmented Generation (RAG), and leveraged vector search for efficient retrieval and relevance ranking.
            \item Developed an AI agent to generate documentation from function signatures/metadata by constructing prompts and using Amazon Q integrated with LangChain to produce human-readable documentation.
            \item Designed and implemented a stateless product pipeline with event-driven architecture using Temporal, reducing tight coupling and improving reliability.
            \item Transitioned infrastructure code and customer environments from Pulumi to Terraform, improving provisioning repeatability and deployment stability.
            \item Achieved a 5x performance improvement in data deduplication by redesigning the architecture with Kotlin coroutines to minimize database and RabbitMQ load.
            \item Streamlined data ingestion using Temporal and managed CI/CD deployments into EKS with Terraform.
            \item Spearheaded MongoDB sharding and large-scale dataset regeneration, supporting high-volume processing workloads.
            \item Managed large-scale ingestion pipelines using Spark, AWS Lambda, EMR, and Kubernetes for multi-tenant processing at scale.
            \item Built an inference/analytics model to detect gaps in structured data using association mining techniques.
            \item Automated terminology updates with Python and SQL Server stored procedures to support normalization and downstream analytics.
        \end{highlights}

        \vspace{0.2 cm}

        \textbf{Diameter Health} \hfill \textit{Jun 2019 – Aug 2019 | Boston, MA} \\
        Informatics and Engineering Intern
        \begin{highlights}
            \item Developed a transpiler in Golang to convert Clinical Quality Language into JavaScript, automating boilerplate code generation.
            \item Designed and implemented a synthetic data generator for clinical HL7 messages in JavaScript, accelerating testing and development cycles.
        \end{highlights}

    \end{onecolentry}

