    %==================== Profile ====================

    \section{Profile}
    \begin{onecolentry}
        Senior Developer with 5+ years of experience leading high-performance teams and architecting scalable microservices in the Node.js, Java Spring, and Python FastAPI ecosystems. Adept at designing and deploying robust data pipelines using Apache Spark and Scala, as well as developing innovative chatbot solutions leveraging Large Language Models (LLMs) with Retrieval-Augmented Generation (RAG) techniques. Proven track record in delivering reliable, scalable applications that drive business growth and operational efficiency.
    \end{onecolentry}

    %==================== Skills ====================

    \section{Skills}
    \begin{onecolentry}
        \textbf{Programming:} Javascript, Kotlin, Python, Java, React, Flask, Go, SQL, bash, HTML, CSS, HCL \\
        \textbf{Databases:} MongoDB, MSSQL Server \\
        \textbf{Frameworks \& Tools:} Temporal, Spring Boot, Spark, TensorFlow, RabbitMQ, Docker, Kubernetes, Helm, Terraform, Pulumi, AWS, Git, Jenkins
    \end{onecolentry}

    %==================== Experience ====================

    \section{Experience}
    \begin{onecolentry}
        \textbf{Availity} \hfill \textit{Feb 2020 – Present | Boston, MA} \\
        Software Engineer IV
        \begin{highlights}
            \item Designed and implemented a microservices-based, stateless product pipeline with an event-driven architecture on Temporal, reducing dependency on MongoDB.
            \item Transitioned infrastructure code and customer environments from Pulumi to Terraform, enhancing cloud infrastructure stability.
            \item Achieved a 5x performance improvement in FHIR data deduplication by redesigning the architecture with Kotlin coroutines to minimize database and RabbitMQ load.
            \item Streamlined FHIR data ingestion using Temporal and managed CI/CD deployments into EKS with Terraform.
            \item Spearheaded MongoDB sharding for large-scale healthcare data, regenerating 6 billion FHIR resources for 10 million patients.
            \item Managed large-scale claims data ingestion using Spark, AWS Lambda, EMR, and Kubernetes for 13 million patients.
            \item Built a clinical inference model to detect data gaps and created realistic clinical synthetic notes using GPT-2 models.
            \item Automated terminology updates to enable data normalization and support decision-making during COVID-19.
        \end{highlights}

        \vspace{0.2 cm}
        \textbf{Diameter Health} \hfill \textit{Jun 2019 – Aug 2019 | Boston, MA} \\
        Informatics and Engineering Intern
        \begin{highlights}
            \item Developed a transpiler in Golang to convert clinical quality language into JavaScript, automating boilerplate code generation.
            \item Designed and implemented a synthetic data generator for clinical HL7 messages in JavaScript, accelerating testing and development cycles.
        \end{highlights}
    \end{onecolentry}

    %==================== Projects ====================

    \section{Projects}
    \begin{onecolentry}
        \textbf{Confluence Chatbot for Internal Knowledge Management} \hfill \textit{2023} \\
        \begin{highlights}
            \item Developed an internal chatbot for Confluence to assist employees in quickly locating documentation and troubleshooting guides.
            \item Built RESTful endpoints using Python FastAPI to manage API interactions.
            \item Integrated Large Language Models using a Retrieval-Augmented Generation (RAG) framework to generate context-aware responses.
            \item Leveraged vector databases to store and rapidly retrieve embeddings for efficient search and relevance ranking.
            \item Improved internal productivity by reducing time-to-information and enhancing user experience.
        \end{highlights}
    \end{onecolentry}

